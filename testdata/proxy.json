      "url": "http://localhost:9357/api/v1/proxy/googleai/",
      "upstreamUrl": "https://generativelanguage.googleapis.com/",
      "allowedPaths": [
        "v1beta/models",
        "v1beta/models/*",
        "v1/models",
        "v1/models/*"
      ],
      "isActive": true
    },
    {
      "name": "googleai_openai",
      "description": "Passthrough access to the Google Gemini API's OpenAI-compatible chat completions, embeddings and models.",
      "provider": "googleai",
      "url": "http://localhost:9357/api/v1/proxy/googleai_openai/",
      "upstreamUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
      "allowedPaths": [
        "chat/completions",
        "embeddings",
        "models",
        "models/*"
      ],
      "isActive": true
    },
    {
      "name": "metaai",
      "description": "Passthrough access to Meta's Llama API chat completions, moderations and models, native and OpenAI-compatible.",
      "provider": "metaai",
      "url": "http://localhost:9357/api/v1/proxy/metaai/",
