    {
      "name": "togetherai",
      "description": "Passthrough access to the Together AI API's OpenAI-compatible chat completions, completions, embeddings and models.",
      "provider": "togetherai",
      "url": "http://localhost:9357/api/v1/proxy/togetherai/",
