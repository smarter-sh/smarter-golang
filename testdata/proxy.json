{
  "proxies": [
    {
      "name": "anthropic",
      "description": "Passthrough access to Anthropic's Messages API, for Claude.",
      "provider": "anthropic",
      "url": "http://localhost:9357/api/v1/proxy/anthropic/",
      "upstreamUrl": "https://api.anthropic.com/",
      "allowedPaths": [
        "v1/messages",
        "v1/messages/count_tokens",
        "v1/models",
        "v1/models/*"
      ],
      "isActive": true
    },
    {
      "name": "cohere",
      "description": "Passthrough access to the Cohere API's chat, embed, rerank and models endpoints.",
      "provider": "cohere",
      "url": "http://localhost:9357/api/v1/proxy/cohere/",
      "upstreamUrl": "https://api.cohere.com/",
      "allowedPaths": [
        "v2/chat",
        "v2/embed",
        "v2/rerank",
        "v1/chat",
        "v1/embed",
        "v1/rerank",
        "v1/models",
        "v1/models/*"
      ],
      "isActive": true
    },
    {
      "name": "fireworks",
      "description": "Passthrough access to the Fireworks AI API's OpenAI-compatible chat completions, completions, embeddings and models.",
      "provider": "fireworks",
      "url": "http://localhost:9357/api/v1/proxy/fireworks/",
      "upstreamUrl": "https://api.fireworks.ai/inference/v1/",
      "allowedPaths": [
        "chat/completions",
        "completions",
        "embeddings",
        "models"
      ],
      "isActive": true
    },
    {
      "name": "googleai",
