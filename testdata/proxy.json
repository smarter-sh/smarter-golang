      "allowedPaths": [
        "v1/chat/completions",
        "v1/moderations",
        "v1/models",
        "v1/models/*",
        "compat/v1/chat/completions",
        "compat/v1/models"
      ],
      "isActive": true
    },
    {
      "name": "mistral",
      "description": "Passthrough access to the Mistral AI API's chat completions, code completions, embeddings and models.",
      "provider": "mistral",
